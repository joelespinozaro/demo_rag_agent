# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
ASSISTANT_NAME=Asistente

# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
HISTORY_LIMIT=10
RETRIEVAL_LIMIT=5
RETRIEVAL_CANDIDATES=15
QUERY_EXPANSION_COUNT=3

# Qdrant
QDRANT_URL=https://your-cluster-url.qdrant.tech
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_COLLECTION_NAME=data-academy
# Busqueda hibrida (rama rag_agents_hybrid)
SEARCH_MODE=hybrid
QDRANT_HYBRID_COLLECTION=data-academy-hybrid
HYBRID_PREFETCH_LIMIT=30
HYBRID_RRF_K=60

# GraphRAG con Neo4j Aura Free (Lab 2: cambiar a true cuando tengas tu instancia)
GRAPH_ENABLED=false
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-neo4j-password
NEO4J_DATABASE=
GRAPH_SEED_K=4
GRAPH_MAX_RELATIONS=15