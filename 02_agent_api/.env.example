# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
HISTORY_LIMIT=10

# Neon MCP - BD (opcional - dejar en blanco para deshabilitar)
NEON_API_KEY=
NEON_PROJECT_ID=

# Demo MCP server — servicio propio (03_mcp_server), HTTP (opcional - dejar en
# blanco para deshabilitar). Local: correr 03_mcp_server aparte (`python -m
# src.main`) y apuntar acá a su URL streamable-http (puerto por defecto 8000).
# Producción: URL del Cloud Run de 03_mcp_server (privado — se autentica con
# ID token de Google vía src/utils/gcp_auth.py, ver DEPLOYMENT.md).
# Nota: retrieve_documents (Qdrant) vive en 03_mcp_server, así que dejar esto en blanco
# también deshabilita la búsqueda en la base de conocimiento — ver 03_mcp_server/.env.example
# para configurar QDRANT_URL / QDRANT_API_KEY / QDRANT_COLLECTION_NAME allá.
DEMO_MCP_SERVER_URL=http://localhost:8000/mcp

# Groq (InputGuardrail — Capas 7 y 8: Llama Prompt Guard 2 y Llama Guard 4)
GROQ_API_KEY=gsk_...
GROQ_PROMPT_GUARD_MODEL=meta-llama/Llama-Prompt-Guard-2-86M
GROQ_LLAMA_GUARD_MODEL=openai/gpt-oss-safeguard-20b
GROQ_TIMEOUT_SECONDS=3

# InputGuardrail — Capa 4 (timeout anti-ReDoS por regla, en segundos)
CUSTOM_REGEX_TIMEOUT_SECONDS=1

# InputGuardrail — motor de content-safety: "model_armor" (GCP, default) o
# "local" (regex + Groq, sin dependencia de GCP). Si GUARDRAIL_ENGINE=model_armor
# pero falta MODEL_ARMOR_PROJECT_ID/TEMPLATE_ID, o no hay credenciales GCP
# válidas, cae automáticamente a "local" sin romper el arranque.
GUARDRAIL_ENGINE=model_armor
MODEL_ARMOR_PROJECT_ID=
MODEL_ARMOR_LOCATION=us-central1
MODEL_ARMOR_TEMPLATE_ID=
MODEL_ARMOR_TIMEOUT_SECONDS=3
# Ruta absoluta al JSON de la service account con permisos de Model Armor.
# Alternativa: dejar en blanco y correr `gcloud auth application-default login`.
GOOGLE_APPLICATION_CREDENTIALS=

# LangSmith (trazas de LangChain — opcional, dejar LANGSMITH_TRACING=false para deshabilitar)
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=default