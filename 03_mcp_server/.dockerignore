# Variables de entorno (nunca deben ir en la imagen)
.env
.env.*
!.env.example

# Git
.git
.gitignore

# Python cache
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Entornos virtuales
.venv/
venv/
env/

# Testing y linting
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage

# IDEs
.idea/
.vscode/

# Build artifacts
*.egg-info/
dist/
build/

# Logs
*.log

# Documentación — excepto skills/*/SKILL.md, que el servidor lee en runtime
# (src/repositories/skills_repository.py::discover_skills) y debe quedar en la imagen.
*.md
!skills/**/*.md

# Docker mismo
Dockerfile
.dockerignore
