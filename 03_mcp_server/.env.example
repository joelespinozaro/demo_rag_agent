# PokeAPI (demo pública, sin auth)
POKEAPI_BASE_URL=https://pokeapi.co/api/v2
HTTP_TIMEOUT_SECONDS=10

# OpenAI (embeddings para retrieve_documents)
OPENAI_API_KEY=sk-...

# Qdrant (base de conocimiento para retrieve_documents)
QDRANT_URL=https://your-cluster-url.qdrant.tech
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_COLLECTION_NAME=data-academy

# SuperheroAPI (https://superheroapi.com/) - héroes y villanos
SUPERHERO_API_BASE_URL=https://www.superheroapi.com/api.php
SUPERHERO_API_TOKEN=your-superheroapi-access-token
